---
import Tags from './Tags.astro';
const { title, description, pubDate, tags, num, slug } = Astro.props;
import "../styles/global.css";
---

<a href={`${import.meta.env.BASE_URL}project/${slug}`} class="project-item" data-card data-tags={tags.join(',')} data-title={title.toLowerCase()}>
  <div class="proj-left">
    <div class="proj-num">{num}</div>
    <div class="proj-title">{title}</div>
    <div class="proj-desc">{description}</div>
    <Tags tags={tags} />
  </div>
  <div class="proj-right">
    <div class="proj-date">{pubDate}</div>
  </div>
</a>

<style>

.project-item {
  padding: 1.25rem 0;
  border-bottom: 0.5px solid var(--bg2);
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: start;
  gap: 1rem;
  cursor: pointer;
    text-decoration: none;
}
.project-item:first-child {
  border-top: 0.5px solid var(--bg2);
}
.project-item:hover .proj-title {
  color: var(--yellow);
}

.proj-num {
  font-size: 0.8rem;
  font-family: "JetBrains Mono", monospace;
  color: var(--fg4);
  margin-bottom: 0.35rem;
}
.proj-title {
  font-size: 1.3rem;
  font-weight: 400;
  font-style: italic;
  margin-bottom: 0.3rem;
  color: var(--fg);
  transition: color 0.15s;
}
.proj-desc {
  font-size: 1rem;
  color: var(--fg3);
  line-height: 1.6;
}

.proj-right {
  text-align: right;
  padding-top: 4px;
  color: var(--fg4);
}
.proj-date {
  font-size: 0.6rem;
  font-family: "JetBrains Mono", monospace;
  color: var(--fg4);
}

</style>
