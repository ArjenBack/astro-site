---
const { tags } = Astro.props;

import { tagColors } from '../lib/tagColors';
---

<div class="tags">
    {tags.map((tag: string, i: number) => (
    <span class="tag" style={`color: ${tagColors[tag.toLowerCase()] ?? 'var(--fg4)'}`}>
          {tag}{i < tags.length - 1 ? <span class="sep"> · </span> : ""}
    </span>
  ))}
</div>

<style>
.tag {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85rem;
    background: none;
    border: none;
    padding: 0;
}

.tags {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.sep {
  color: var(--fg4);
}
</style>
